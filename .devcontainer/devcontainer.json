{
  "name": "Ambiente SGIE",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -r backend/requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "yandeu.five-server"
      ],
      "settings": {
        "python.analysis.extraPaths": [
          "./backend"
        ],
        "python.autoComplete.extraPaths": [
          "./backend"
        ],
        "django.managePyPath": "backend/manage.py",
        "fiveServer.root": "frontend"
      }
    }
  }
}