{
  "name": "Ambiente SGIE",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -r backend/requirements-dev.txt",
  "forwardPorts": [8000, 5500],
  "portsAttributes": {
    "8000": {
      "label": "SGIE Backend API (Django)",
      "onAutoForward": "silent"
    },
    "5500": {
      "label": "SGIE Frontend (Five Server)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "yandeu.five-server"
      ],
      "settings": {
        "python.analysis.extraPaths": [
          "./backend"
        ],
        "python.autoComplete.extraPaths": [
          "./backend"
        ],
        "django.managePyPath": "backend/manage.py",
        "fiveServer.root": "frontend",
        "fiveServer.notify": false,
        "fiveserver.notify": false
      }
    }
  }
}